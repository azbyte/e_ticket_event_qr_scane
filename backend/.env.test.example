# Contoh konfigurasi lokal saja. Duplikasikan sebagai .env.test, pastikan PostgreSQL
# lokal hanya berisi data disposable, lalu isi kredensial lokal. Jangan arahkan ke
# Supabase/host remote. Harness akan menolak host/database yang bukan loopback/test.
NODE_ENV=test
PORT=5000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/e_ticket_test
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/e_ticket_test
TEST_API_URL=http://127.0.0.1:5000
ALLOW_DESTRUCTIVE_TESTS=true
JWT_SECRET=local-test-only-secret-change-me
SIMULATED_PAYMENTS_ENABLED=true
SEED_DEMO_ACCOUNTS=false
SMTP_HOST=json