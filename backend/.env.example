# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to true to create/update the bcrypt-hashed admin and organizer demo accounts at startup.
# Requires the Supabase migration in supabase/migrations to be applied first.
SEED_DEMO_ACCOUNTS=false

# JWT
JWT_SECRET=your-super-secret-jwt-secret
JWT_EXPIRES_IN=7d

# CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.dsnxralkzaxzsyigtcqp:Eticket123!123@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.dsnxralkzaxzsyigtcqp:Eticket123!123@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"