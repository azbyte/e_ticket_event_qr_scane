# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Supabase (legacy, tidak dipakai backend saat ini; backend memakai DATABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma / PostgreSQL: use pooled URL for application traffic and direct URL for migrations.
# Replace these placeholders with Supabase connection details; never commit backend/.env.
DATABASE_URL=postgresql://postgres:password@pooler-host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db-host:5432/postgres

# ---------------------------------------------------------------------------
# Bootstrap akun Admin platform (WAJIB untuk login Admin pertama kali).
# Isi pada backend/.env lokal (jangan commit .env). Tidak ada password default
# di source code. Jalankan sekali: npm run admin:provision
# Skrip idempotent: akun Admin tidak dibuat duplikat.
# Password hanya diubah bila ADMIN_RESET_PASSWORD=true.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_NAME=Administrator Platform
# Opsional: username login (default diturunkan dari email).
ADMIN_USERNAME=admin
# Set true hanya saat ingin merotasi password Admin yang sudah ada.
ADMIN_RESET_PASSWORD=false

# Legacy: akun demo dengan password tetap sudah dihapus dari source code.
# Organizer dibuat lewat POST /api/auth/register; Admin lewat npm run admin:provision.
SEED_DEMO_ACCOUNTS=false

# Simulasi pembayaran aktif di lingkungan non-produksi (development/test/staging)
# agar alur checkout dapat diuji tanpa payment gateway.
# Di NODE_ENV=production fitur ini nonaktif kecuali disetel `true` (JANGAN aktifkan di produksi nyata).
SIMULATED_PAYMENTS_ENABLED=true

# URL publik aplikasi Flutter (dipakai untuk `public_url` event dan `invite_url`).
# Contoh demo web: http://localhost:3000 (flutter run -d chrome --web-port=3000).
APP_PUBLIC_URL=http://localhost:3000

# Integration harness is destructive: use a dedicated local test DB/API only.
ALLOW_DESTRUCTIVE_TESTS=false
TEST_API_URL=http://127.0.0.1:5000

# JWT
JWT_SECRET=your-super-secret-jwt-secret
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Undangan staf berbasis nama + kode akses.
#
# Kode akses TIDAK disimpan plaintext: database menyimpan hash (SHA-256) untuk
# verifikasi dan ciphertext AES-256-GCM agar Organizer dapat menampilkan kembali
# kode milik event-nya. STAFF_ACCESS_SECRET adalah kunci enkripsi tersebut;
# gunakan nilai acak panjang yang berbeda dari JWT_SECRET.
# Bila kosong, backend memakai JWT_SECRET (kompatibilitas), tetapi produksi
# sebaiknya memakai nilai terpisah.
# ---------------------------------------------------------------------------
STAFF_ACCESS_SECRET=replace-with-a-long-random-staff-access-secret
# Masa berlaku sesi staf setelah kode akses divalidasi (format `12h`, `1d`, `7d`).
STAFF_SESSION_TTL=12h

# CORS (frontend URL). ALLOWED_ORIGINS mendukung daftar dipisah koma.
ALLOWED_ORIGINS=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Email e-ticket (Brevo SMTP via Nodemailer).
# Tiket dikirim sebagai lampiran PDF (desain tiket + QR unik) ke email peserta
# yang terdaftar di database.
#
# Penyedia aktif: Brevo (https://www.brevo.com) melalui SMTP relay
#   host : smtp-relay.brevo.com
#   port : 587 (STARTTLS)  |  465 (TLS implisit, SMTP_SECURE=true)
#
# Langkah di dashboard Brevo:
#   1. SMTP & API > SMTP: salin host, "Login" (biasanya xxxxx@smtp-brevo.com),
#      lalu buat "SMTP key".
#   2. Senders & IP > Senders: tambahkan dan verifikasi EMAIL_FROM di bawah.
#      Brevo MENOLAK (550) alamat From yang belum terverifikasi.
#   3. Isi kredensial HANYA pada backend/.env lokal atau environment deployment.
#      JANGAN commit nilai asli dan jangan menaruhnya di source code.
#
# Urutan pemilihan penyedia:
#   EMAIL_PROVIDER diisi  -> penyedia itu yang dipakai (brevo|smtp|resend|none)
#   EMAIL_PROVIDER kosong -> SMTP/Brevo bila host tersedia, lalu RESEND_API_KEY
#                            (jalur HTTPS API lama), lalu nonaktif.
# Bila transport nonaktif, catatan delivery tetap PENDING + alasan dan TIDAK
# pernah diklaim terkirim.
#
# SMTP_HOST=json -> HANYA untuk pengujian otomatis (NODE_ENV=test).
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=brevo

# --- Brevo SMTP ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# false untuk port 587 (STARTTLS); true untuk port 465 (TLS implisit).
SMTP_SECURE=false
# Wajibkan STARTTLS pada port 587 agar kredensial tidak terkirim polos.
SMTP_REQUIRE_TLS=true
# Login SMTP Brevo (bukan alamat email pribadi), mis. 1234567@smtp-brevo.com.
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
# SMTP key dari dashboard Brevo (bukan password akun Brevo).
SMTP_PASS=your-brevo-smtp-key
# Relay lokal tanpa autentikasi (hanya untuk pengujian): SMTP_ALLOW_LOCAL_RELAY=true
# Batas waktu koneksi SMTP (ms). Jangan lebih besar dari masa klaim pengiriman.
# SMTP_CONNECTION_TIMEOUT_MS=20000
# SMTP_GREETING_TIMEOUT_MS=20000
# SMTP_SOCKET_TIMEOUT_MS=45000

# --- Wajib ---
# Alamat pengirim yang SUDAH DIVERIFIKASI di Brevo (Senders & IP > Senders).
# Bila belum terverifikasi, Brevo menolak pesan (550) dan statusnya dicatat
# FAILED (bukan SENT). Gunakan domain milik sendiri, bukan alamat gratis.
EMAIL_FROM=no-reply@your-verified-domain.com
# Nama tampilan pengirim (opsional).
EMAIL_FROM_NAME=E-Ticket Event

# --- Identitas penyelenggara pada email (From / Reply-To) ---
# Alamat penyelenggara diambil dari akun organizer pembuat event (profiles.email).
# SECARA DEFAULT alamat itu dipasang sebagai Reply-To, sedangkan From memakai
# EMAIL_FROM terverifikasi. Ini mencegah spoofing dan tetap membuat balasan
# peserta menuju penyelenggara.
#
# Isi daftar domain (dipisah koma) HANYA bila domain penyelenggara juga sudah
# diverifikasi sebagai sender di Brevo. Contoh: EMAIL_ORGANIZER_FROM_DOMAINS=eventku.com
# Jangan masukkan domain publik seperti gmail.com: Brevo menolak From alamat
# yang bukan milik akun Anda.
EMAIL_ORGANIZER_FROM_DOMAINS=
# Set false untuk memakai EMAIL_FROM sebagai Reply-To (tanpa identitas organizer).
# EMAIL_REPLY_TO_ORGANIZER=true

# Tombol "Kirim ulang email" benar-benar mengirim ulang tiket yang sama. Jeda
# minimal (detik) mencegah klik ganda men-spam peserta. 0 = tanpa jeda.
# EMAIL_RESEND_COOLDOWN_SECONDS=60

# Masa klaim pengiriman (detik) untuk mencegah email ganda. Bila proses backend
# berhenti di tengah pengiriman, klaim kedaluwarsa dan worker retry mengambil alih.
# EMAIL_SEND_CLAIM_SECONDS=120
# Jeda dasar antar percobaan ulang otomatis (ms), dikali nomor percobaan.
# EMAIL_RETRY_BASE_DELAY_MS=60000

# --- Opsional: jalur HTTPS API lama (fallback, bukan penyedia aktif) ---
# Hanya dipakai bila EMAIL_PROVIDER=resend atau SMTP belum dikonfigurasi.
# RESEND_API_KEY=
# RESEND_API_URL=https://api.resend.com
# Batas waktu permintaan ke HTTPS API penyedia (ms).
# EMAIL_API_TIMEOUT_MS=30000

# --- Verifikasi pengiriman ---
# Alamat inbox nyata untuk uji kirim sungguhan (`npm run verify:brevo -- --to=...`).
# Kosongkan bila belum ingin mengirim email sungguhan (hasil verifikasi BLOCKED).
VERIFY_EMAIL_TO=
# Opsional: API key Brevo (bukan SMTP key) untuk memeriksa event pengiriman
# (delivered/bounce) setelah uji kirim. Hanya dibaca, tidak pernah dicetak.
# BREVO_API_KEY=
