# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Supabase (legacy, tidak dipakai backend saat ini; backend memakai DATABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma / PostgreSQL: use pooled URL for application traffic and direct URL for migrations.
# Replace these placeholders with Supabase connection details; never commit backend/.env.
DATABASE_URL=postgresql://postgres:password@pooler-host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db-host:5432/postgres

# ---------------------------------------------------------------------------
# Bootstrap akun Admin platform (WAJIB untuk login Admin pertama kali).
# Isi pada backend/.env lokal (jangan commit .env). Tidak ada password default
# di source code. Jalankan sekali: npm run admin:provision
# Skrip idempotent: akun Admin tidak dibuat duplikat.
# Password hanya diubah bila ADMIN_RESET_PASSWORD=true.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_NAME=Administrator Platform
# Opsional: username login (default diturunkan dari email).
ADMIN_USERNAME=admin
# Set true hanya saat ingin merotasi password Admin yang sudah ada.
ADMIN_RESET_PASSWORD=false

# Legacy: akun demo dengan password tetap sudah dihapus dari source code.
# Organizer dibuat lewat POST /api/auth/register; Admin lewat npm run admin:provision.
SEED_DEMO_ACCOUNTS=false

# Simulasi pembayaran aktif di lingkungan non-produksi (development/test/staging)
# agar alur checkout dapat diuji tanpa payment gateway.
# Di NODE_ENV=production fitur ini nonaktif kecuali disetel `true` (JANGAN aktifkan di produksi nyata).
SIMULATED_PAYMENTS_ENABLED=true

# URL publik aplikasi Flutter (dipakai untuk `public_url` event dan `invite_url`).
# Contoh demo web: http://localhost:3000 (flutter run -d chrome --web-port=3000).
APP_PUBLIC_URL=http://localhost:3000

# Integration harness is destructive: use a dedicated local test DB/API only.
ALLOW_DESTRUCTIVE_TESTS=false
TEST_API_URL=http://127.0.0.1:5000

# JWT
JWT_SECRET=your-super-secret-jwt-secret
JWT_EXPIRES_IN=7d

# CORS (frontend URL). ALLOWED_ORIGINS mendukung daftar dipisah koma.
ALLOWED_ORIGINS=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Email e-ticket (SMTP). Tiket dikirim sebagai lampiran PDF ke email peserta.
#
# SMTP_HOST KOSONG  -> email dinonaktifkan secara jujur: catatan delivery
#                      berstatus PENDING beserta alasannya, TIDAK diklaim
#                      terkirim. Aplikasi menampilkan "email belum terkirim".
# SMTP_HOST=json    -> HANYA untuk pengujian otomatis (NODE_ENV=test).
#                      Di luar test dianggap nonaktif karena tidak mengirim.
# SMTP_HOST=<host>  -> email benar-benar dikirim melalui SMTP.
#
# Isi kredensial pada backend/.env lokal. JANGAN commit nilai asli.
# Contoh Gmail/Workspace: smtp.gmail.com, port 587, SMTP_SECURE=false,
# SMTP_USER=alamat@gmail.com, SMTP_PASS=App Password (bukan password akun).
# EMAIL_FROM WAJIB diisi (alamat pengirim yang valid) saat SMTP nyata dipakai.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Pengirim yang tampil pada email peserta (wajib untuk SMTP nyata).
EMAIL_FROM=
# Hanya untuk `npm run verify:email`: alamat inbox Anda untuk uji kirim nyata.
# Kosongkan bila belum ingin mengirim email sungguhan (hasil verifikasi BLOCKED).
VERIFY_EMAIL_TO=
