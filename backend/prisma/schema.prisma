generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventFormat {
  OFFLINE
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  REVISION_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  SUSPENDED
  COMPLETED
  CANCELLED
}

enum ModerationDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
  SUSPENDED
}

enum EventPermission {
  VIEW_EVENT
  VIEW_PARTICIPANTS
  ASSIST_REGISTRATION
  VIEW_ORDERS
  SCAN_TICKET
  CHECK_IN_TICKET
  VIEW_SCAN_HISTORY
  VIEW_REPORTS
  EXPORT_PARTICIPANTS
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RegistrationMethod {
  SELF_SERVICE
  ASSISTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  SIMULATED_VIRTUAL_ACCOUNT
}

enum ScanResult {
  VALID
  ALREADY_USED
  INVALID
  WRONG_EVENT
  CANCELLED
  REVOKED
  PAYMENT_REQUIRED
  NETWORK_ERROR
}

enum CheckInSource {
  ONLINE
  OFFLINE_SYNC
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_PAYMENT
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum ReportCategory {
  EVENT
  PAYMENT
  E_TICKET
  REGISTRATION
  ACCOUNT
  SUBSCRIPTION
  TRANSACTION
  SCANNER
  OTHER
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReportActivityVisibility {
  PUBLIC
  INTERNAL
}

model User {
  id           String    @id @db.Uuid
  name         String?
  email        String    @unique @db.Text
  username     String?   @db.Text
  passwordHash String?   @map("password_hash") @db.Text
  role         String    @db.Text
  avatarUrl    String?   @map("avatar_url") @db.Text
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organizerProfile    OrganizerProfile?
  createdEvents       Event[]                  @relation("EventCreator")
  eventMemberships    EventMember[]            @relation("MemberUser")
  invitationsSent     EventInvitation[]        @relation("InvitationInviter")
  invitationsUsed     EventInvitation[]        @relation("InvitationAccepter")
  moderationActions   EventModeration[]        @relation("ModerationAdmin")
  orders              EventOrder[]             @relation("OrderPurchaser")
  tickets             Ticket[]                 @relation("TicketHolder")
  scanLogs            ScanLog[]                @relation("ScanActor")
  checkIns            CheckIn[]                @relation("CheckInActor")
  submittedReports    SupportReport[]          @relation("ReportSubmitter")
  assignedReports     SupportReport[]          @relation("ReportAssignee")
  reportActivities    SupportReportActivity[]  @relation("ReportActivityAuthor")
  subscriptions       Subscription[]
  auditLogs           AuditLog[]               @relation("AuditActor")
  eventActivities     EventActivityLog[]       @relation("EventActivityActor")
  notifications       Notification[]
  settingChanges      PlatformSettingHistory[] @relation("SettingHistoryActor")
  subscriptionChanges SubscriptionHistory[]    @relation("SubscriptionHistoryActor")

  @@index([role])
  @@map("profiles")
}

model OrganizerProfile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  organizationName String?  @map("organization_name") @db.Text
  contactName      String?  @map("contact_name") @db.Text
  phone            String?  @db.Text
  website          String?  @db.Text
  description      String?  @db.Text
  logoUrl          String?  @map("logo_url") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organizer_profiles")
}

model EventCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.Text
  slug        String   @unique @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  events Event[]

  @@map("event_categories")
}

model Event {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String      @db.Text
  description       String?     @db.Text
  posterUrl         String?     @map("poster_url") @db.Text
  startDateTime     DateTime?   @map("event_date") @db.Timestamptz(6)
  endDateTime       DateTime?   @map("end_date_time") @db.Timestamptz(6)
  timeZone          String?     @map("time_zone") @db.Text
  location          String?     @db.Text
  onlineUrl         String?     @map("online_url") @db.Text
  format            EventFormat @default(OFFLINE) @map("event_format")
  contactInfo       String?     @map("contact_info") @db.Text
  organizerName     String?     @map("organizer_name") @db.Text
  publicInfo        String?     @map("public_info") @db.Text
  attendeeFields    Json?       @map("attendee_fields")
  status            EventStatus @default(DRAFT)
  reviewNote        String?     @map("review_note") @db.Text
  submittedAt       DateTime?   @map("submitted_at") @db.Timestamptz(6)
  isPublic          Boolean     @default(false) @map("is_public")
  publicUrl         String?     @map("public_url") @db.Text
  registrationQrUrl String?     @map("registration_qr_url") @db.Text

  // Desain tiket default event (PRD §5). Struktur:
  // { source, file_path, content_type, orientation, qr: {x,y,size}, info: {...} }
  // Nilai posisi berupa fraksi 0..1 dari kanvas tiket. Null = desain default
  // yang dirender sistem saat tiket diterbitkan.
  ticketDesign Json? @map("ticket_design")

  // Orientasi kanvas desain tiket: `landscape` (horizontal) atau `portrait`
  // (vertikal). Null = belum diatur; tiket mengikuti default sistem.
  ticketDesignOrientation String? @map("ticket_design_orientation") @db.Text

  // These two legacy columns are still read and written by the current Express API.
  totalTickets Int?     @default(0) @map("total_tickets")
  legacyPrice  Decimal? @default(0) @map("price") @db.Decimal(14, 2)

  createdBy  String?  @map("created_by") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator      User?              @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  category     EventCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ticketTypes  TicketType[]
  orders       EventOrder[]
  members      EventMember[]
  invitations  EventInvitation[]
  moderations  EventModeration[]
  tickets      Ticket[]
  scanLogs     ScanLog[]
  checkIns     CheckIn[]
  activityLogs EventActivityLog[]

  @@index([createdBy], map: "events_created_by_idx")
  @@index([categoryId])
  @@index([status, startDateTime])
  @@map("events")
}

model EventModeration {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String             @map("event_id") @db.Uuid
  adminId   String             @map("admin_id") @db.Uuid
  decision  ModerationDecision
  note      String?            @db.Text
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  admin User  @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@index([adminId, createdAt])
  @@map("event_moderations")
}

model EventMember {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  // Existing SQL constrains this text column to the lowercase value "staff".
  role      String   @default("staff") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event          Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User                    @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  permissions    EventMemberPermission[]
  assistedOrders EventOrder[]
  checkIns       CheckIn[]
  scanLogs       ScanLog[]

  @@unique([eventId, userId], map: "event_members_event_user_unique")
  @@index([userId], map: "event_members_user_id_idx")
  @@map("event_members")
}

model EventMemberPermission {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventMemberId String          @map("event_member_id") @db.Uuid
  permission    EventPermission
  grantedAt     DateTime        @default(now()) @map("granted_at") @db.Timestamptz(6)

  member EventMember @relation(fields: [eventMemberId], references: [id], onDelete: Cascade)

  @@unique([eventMemberId, permission])
  @@map("event_member_permissions")
}

model EventInvitation {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String           @map("event_id") @db.Uuid
  invitedById        String           @map("invited_by_id") @db.Uuid
  acceptedById       String?          @map("accepted_by_id") @db.Uuid
  email              String?          @db.VarChar(320)
  tokenHash          String           @unique @map("token_hash") @db.Text
  // Undangan staf berbasis nama + kode akses (lihat migration
  // 20261201000000_staff_access_codes). Kode akses TIDAK disimpan plaintext.
  staffName          String?          @map("staff_name")
  accessCodeHash     String?          @unique @map("access_code_hash") @db.Text
  accessCodeCipher   String?          @map("access_code_cipher") @db.Text
  accessCodeIssuedAt DateTime?        @map("access_code_issued_at") @db.Timestamptz(6)
  status             InvitationStatus @default(PENDING)
  expiresAt          DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt         DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt          DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  event       Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviter     User                        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  accepter    User?                       @relation("InvitationAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  permissions EventInvitationPermission[]
  checkIns    CheckIn[]                   @relation("CheckInStaffInvitation")
  scanLogs    ScanLog[]                   @relation("ScanLogStaffInvitation")

  @@index([eventId, status, expiresAt])
  @@index([email, status])
  @@index([eventId, staffName])
  @@map("event_invitations")
}

model EventInvitationPermission {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventInvitationId String          @map("event_invitation_id") @db.Uuid
  permission        EventPermission
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  invitation EventInvitation @relation(fields: [eventInvitationId], references: [id], onDelete: Cascade)

  @@unique([eventInvitationId, permission])
  @@map("event_invitation_permissions")
}

model TicketType {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  name        String    @db.Text
  description String?   @db.Text
  price       Decimal   @db.Decimal(14, 2)
  quota       Int
  sold        Int       @default(0)
  held        Int       @default(0)
  maxPerOrder Int?      @map("max_per_order")
  salesStart  DateTime? @map("sales_start") @db.Timestamptz(6)
  salesEnd    DateTime? @map("sales_end") @db.Timestamptz(6)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Desain khusus kategori ini (menimpa desain default event bila terisi).
  ticketDesign Json? @map("ticket_design")

  // Orientasi kanvas desain tiket kategori ini (landscape/portrait).
  // Null = belum diatur; mewarisi orientasi event.
  ticketDesignOrientation String? @map("ticket_design_orientation") @db.Text

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@unique([eventId, name])
  @@index([eventId, isActive, salesStart, salesEnd])
  @@map("ticket_types")
}

model EventOrder {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber            String             @unique @map("order_number") @db.VarChar(64)
  eventId                String             @map("event_id") @db.Uuid
  purchaserId            String?            @map("purchaser_id") @db.Uuid
  assistedByMemberId     String?            @map("assisted_by_member_id") @db.Uuid
  registrationMethod     RegistrationMethod @default(SELF_SERVICE) @map("registration_method")
  guestName              String?            @map("guest_name") @db.Text
  guestEmail             String?            @map("guest_email") @db.VarChar(320)
  guestPhone             String?            @map("guest_phone") @db.VarChar(40)
  guestAccessTokenHash   String?            @unique @map("guest_access_token_hash") @db.Text
  idempotencyKey         String?            @unique @map("idempotency_key") @db.Text
  idempotencyFingerprint String?            @map("idempotency_fingerprint") @db.Text
  status                 OrderStatus        @default(PENDING_PAYMENT)
  subtotal               Decimal            @db.Decimal(14, 2)
  serviceFee             Decimal            @default(0) @map("service_fee") @db.Decimal(14, 2)
  commissionRate         Decimal            @default(0) @map("commission_rate") @db.Decimal(9, 6)
  commissionAmount       Decimal            @default(0) @map("commission_amount") @db.Decimal(14, 2)
  grandTotal             Decimal            @map("grand_total") @db.Decimal(14, 2)
  expiresAt              DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event            Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  purchaser        User?           @relation("OrderPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  assistedByMember EventMember?    @relation(fields: [assistedByMemberId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         OrderPayment[]
  reports          SupportReport[]

  @@index([eventId, status, createdAt])
  @@index([purchaserId, createdAt])
  @@index([assistedByMemberId])
  @@map("event_orders")
}

model OrderItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  ticketTypeId String  @map("ticket_type_id") @db.Uuid
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(14, 2)
  subtotal     Decimal @db.Decimal(14, 2)

  order      EventOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  attendees  Attendee[]

  @@unique([orderId, ticketTypeId])
  @@index([ticketTypeId])
  @@map("order_items")
}

model Attendee {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId  String   @map("order_item_id") @db.Uuid
  name         String   @db.Text
  email        String?  @db.VarChar(320)
  phone        String?  @db.VarChar(40)
  organization String?  @db.Text
  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  ticket    Ticket?

  @@index([orderItemId])
  @@map("attendees")
}

model OrderPayment {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String        @map("order_id") @db.Uuid
  method               PaymentMethod @default(SIMULATED_VIRTUAL_ACCOUNT)
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(14, 2)
  paymentReference     String?       @unique @map("payment_reference") @db.Text
  idempotencyKey       String?       @unique @map("idempotency_key") @db.Text
  virtualAccountNumber String?       @map("virtual_account_number") @db.Text
  virtualAccountBank   String?       @map("virtual_account_bank") @db.Text
  expiresAt            DateTime?     @map("expires_at") @db.Timestamptz(6)
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz(6)
  failureReason        String?       @map("failure_reason") @db.Text
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order        EventOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions PlatformTransaction[]

  @@index([orderId, status])
  @@map("order_payments")
}

model Ticket {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketCode   String  @unique @map("ticket_code") @db.Text
  tokenHash    String? @unique @map("token_hash") @db.Text
  eventId      String  @map("event_id") @db.Uuid
  userId       String? @map("user_id") @db.Uuid
  ticketTypeId String? @map("ticket_type_id") @db.Uuid
  attendeeId   String? @unique @map("attendee_id") @db.Uuid
  qrCodeData   String? @map("qr_code_data") @db.Text

  // String preserves the lowercase values used by the legacy tickets API.
  status      String    @default("active") @db.Text
  purchasedAt DateTime  @default(now()) @map("purchased_at") @db.Timestamptz(6)
  issuedAt    DateTime? @map("issued_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)

  event      Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user       User?                 @relation("TicketHolder", fields: [userId], references: [id], onDelete: SetNull)
  ticketType TicketType?           @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  attendee   Attendee?             @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  scanLogs   ScanLog[]
  checkIn    CheckIn?
  deliveries TicketEmailDelivery[]

  @@index([eventId, status])
  @@index([userId, purchasedAt])
  @@map("tickets")
}

model ScanLog {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String     @map("event_id") @db.Uuid
  ticketId         String?    @map("ticket_id") @db.Uuid
  scannedByUserId  String?    @map("scanned_by_user_id") @db.Uuid
  eventMemberId    String?    @map("event_member_id") @db.Uuid
  // Staf undangan (nama + kode akses) tidak punya akun; jejak audit memakai
  // undangan yang dipakai saat memindai.
  staffInvitationId String?   @map("staff_invitation_id") @db.Uuid
  clientScanId     String?    @map("client_scan_id") @db.Text
  scannedTokenHash String?    @map("scanned_token_hash") @db.Text
  result           ScanResult
  isOffline        Boolean    @default(false) @map("is_offline")
  scannedAt        DateTime   @default(now()) @map("scanned_at") @db.Timestamptz(6)

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticket Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  actor  User?        @relation("ScanActor", fields: [scannedByUserId], references: [id], onDelete: SetNull)
  member EventMember? @relation(fields: [eventMemberId], references: [id], onDelete: SetNull)
  staffInvitation EventInvitation? @relation("ScanLogStaffInvitation", fields: [staffInvitationId], references: [id], onDelete: SetNull)

  @@unique([eventId, clientScanId])
  @@index([eventId, scannedAt])
  @@index([ticketId, scannedAt])
  @@index([result, scannedAt])
  @@map("scan_logs")
}

model CheckIn {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId      String        @unique @map("ticket_id") @db.Uuid
  eventId       String        @map("event_id") @db.Uuid
  // Boleh NULL untuk staf undangan (tanpa akun). Salah satu dari
  // `actor_user_id` atau `staff_invitation_id` selalu terisi.
  actorUserId   String?       @map("actor_user_id") @db.Uuid
  eventMemberId String?       @map("event_member_id") @db.Uuid
  staffInvitationId String?   @map("staff_invitation_id") @db.Uuid
  source        CheckInSource @default(ONLINE)
  checkedInAt   DateTime      @default(now()) @map("checked_in_at") @db.Timestamptz(6)
  syncedAt      DateTime?     @map("synced_at") @db.Timestamptz(6)
  clientScanId  String?       @map("client_scan_id") @db.Text

  ticket Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event  Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actor  User?        @relation("CheckInActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  member EventMember? @relation(fields: [eventMemberId], references: [id], onDelete: SetNull)
  staffInvitation EventInvitation? @relation("CheckInStaffInvitation", fields: [staffInvitationId], references: [id], onDelete: SetNull)

  @@unique([eventId, clientScanId])
  @@index([eventId, checkedInAt])
  @@map("check_ins")
}

model TicketEmailDelivery {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId      String              @map("ticket_id") @db.Uuid
  recipient     String              @db.VarChar(320)
  status        EmailDeliveryStatus @default(PENDING)
  attemptCount  Int                 @default(0) @map("attempt_count")
  lastError     String?             @map("last_error") @db.Text
  nextAttemptAt DateTime?           @map("next_attempt_at") @db.Timestamptz(6)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([ticketId, createdAt])
  @@map("ticket_email_deliveries")
}

model Plan {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String     @unique @db.Text
  description        String?    @db.Text
  status             PlanStatus @default(ACTIVE)
  isFree             Boolean    @default(false) @map("is_free")
  priceMonthly       Decimal?   @map("price_monthly") @db.Decimal(14, 2)
  priceYearly        Decimal?   @map("price_yearly") @db.Decimal(14, 2)
  maxActiveEvents    Int?       @map("max_active_events")
  maxTicketsPerEvent Int?       @map("max_tickets_per_event")
  maxStaffPerEvent   Int?       @map("max_staff_per_event")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  features       PlanFeature[]
  subscriptions  Subscription[]
  oldPlanHistory SubscriptionHistory[] @relation("SubscriptionFromPlan")
  newPlanHistory SubscriptionHistory[] @relation("SubscriptionToPlan")

  @@index([status])
  @@map("plans")
}

model PlanFeature {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  key       String   @db.Text
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("plan_features")
}

model Subscription {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId     String             @map("organizer_id") @db.Uuid
  planId          String             @map("plan_id") @db.Uuid
  status          SubscriptionStatus @default(ACTIVE)
  billingInterval BillingInterval?   @map("billing_interval")
  startsAt        DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime           @map("ends_at") @db.Timestamptz(6)
  autoRenew       Boolean            @default(false) @map("auto_renew")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizer User                  @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  plan      Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  history   SubscriptionHistory[]
  payments  SubscriptionPayment[]

  @@index([organizerId, status, endsAt])
  @@index([planId, status])
  @@map("subscriptions")
}

model SubscriptionHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  fromPlanId     String?  @map("from_plan_id") @db.Uuid
  toPlanId       String?  @map("to_plan_id") @db.Uuid
  changedById    String?  @map("changed_by_id") @db.Uuid
  reason         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  fromPlan     Plan?        @relation("SubscriptionFromPlan", fields: [fromPlanId], references: [id], onDelete: SetNull)
  toPlan       Plan?        @relation("SubscriptionToPlan", fields: [toPlanId], references: [id], onDelete: SetNull)
  changedBy    User?        @relation("SubscriptionHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
  @@map("subscription_history")
}

model SubscriptionPayment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId   String        @map("subscription_id") @db.Uuid
  invoiceNumber    String        @unique @map("invoice_number") @db.VarChar(64)
  amount           Decimal       @db.Decimal(14, 2)
  method           String        @db.Text
  status           PaymentStatus @default(PENDING)
  paymentReference String?       @unique @map("payment_reference") @db.Text
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  expiresAt        DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  transactions PlatformTransaction[]

  @@index([subscriptionId, status])
  @@map("subscription_payments")
}

model PlatformTransaction {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderPaymentId        String?  @unique @map("order_payment_id") @db.Uuid
  subscriptionPaymentId String?  @unique @map("subscription_payment_id") @db.Uuid
  grossAmount           Decimal  @default(0) @map("gross_amount") @db.Decimal(14, 2)
  commissionRate        Decimal  @default(0) @map("commission_rate") @db.Decimal(9, 6)
  commissionAmount      Decimal  @default(0) @map("commission_amount") @db.Decimal(14, 2)
  serviceFee            Decimal  @default(0) @map("service_fee") @db.Decimal(14, 2)
  platformRevenue       Decimal  @default(0) @map("platform_revenue") @db.Decimal(14, 2)
  organizerNetAmount    Decimal? @map("organizer_net_amount") @db.Decimal(14, 2)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderPayment        OrderPayment?        @relation(fields: [orderPaymentId], references: [id], onDelete: Restrict)
  subscriptionPayment SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("platform_transactions")
}

model SupportReport {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketNumber    String         @unique @map("ticket_number") @db.VarChar(64)
  statusTokenHash String         @unique @map("status_token_hash") @db.Text
  reporterId      String?        @map("reporter_id") @db.Uuid
  assignedToId    String?        @map("assigned_to_id") @db.Uuid
  orderId         String?        @map("order_id") @db.Uuid
  contactEmail    String?        @map("contact_email") @db.VarChar(320)
  orderReference  String?        @map("order_reference") @db.Text
  category        ReportCategory
  subject         String         @db.Text
  description     String         @db.Text
  status          ReportStatus   @default(OPEN)
  priority        ReportPriority @default(MEDIUM)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt      DateTime?      @map("resolved_at") @db.Timestamptz(6)

  reporter   User?                   @relation("ReportSubmitter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee   User?                   @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  order      EventOrder?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  activities SupportReportActivity[]

  @@index([status, priority, createdAt])
  @@index([reporterId, createdAt])
  @@index([assignedToId, status])
  @@map("support_reports")
}

model SupportReportActivity {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId   String                   @map("report_id") @db.Uuid
  authorId   String?                  @map("author_id") @db.Uuid
  authorName String?                  @map("author_name") @db.Text
  visibility ReportActivityVisibility @default(PUBLIC)
  action     String                   @db.Text
  message    String?                  @db.Text
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  report SupportReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  author User?         @relation("ReportActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@index([visibility, createdAt])
  @@map("support_report_activities")
}

model PlatformSetting {
  key       String   @id @db.Text
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  history PlatformSettingHistory[]

  @@map("platform_settings")
}

model PlatformSettingHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingKey  String   @map("setting_key") @db.Text
  oldValue    Json?    @map("old_value")
  newValue    Json     @map("new_value")
  changedById String?  @map("changed_by_id") @db.Uuid
  reason      String?  @db.Text
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  setting   PlatformSetting @relation(fields: [settingKey], references: [key], onDelete: Restrict)
  changedBy User?           @relation("SettingHistoryActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([settingKey, changedAt])
  @@map("platform_setting_history")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name") @db.Text
  actorRole  String?  @map("actor_role") @db.Text
  action     String   @db.Text
  entityType String   @map("entity_type") @db.Text
  entityId   String   @map("entity_id") @db.Text
  reason     String?  @db.Text
  details    String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model EventActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorName String?  @map("actor_name") @db.Text
  action    String   @db.Text
  summary   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actor User? @relation("EventActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
  @@map("event_activity_logs")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  category  String    @db.Text
  title     String    @db.Text
  body      String    @db.Text
  targetUrl String?   @map("target_url") @db.Text
  metadata  Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model RevokedToken {
  tokenHash String   @id @map("token_hash") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "revoked_tokens_expires_at_idx")
  @@map("revoked_tokens")
}
