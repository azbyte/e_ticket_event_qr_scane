{
    "name":  "e-ticket-event-qr-scane-backend",
    "version":  "1.0.0",
    "description":  "Backend API for e-ticket event QR scan mobile app (Flutter)",
    "main":  "server.js",
    "scripts":  {
                    "start":  "node server.js",
                    "dev":  "nodemon server.js",
                    "test":  "node --test",
                    "test:sync-config":  "node --test ../.github/scripts/validate-sync-config.test.js",
                    "check":  "node scripts/check-syntax.js",
                    "lint":  "node scripts/check-syntax.js",
                    "format:check":  "node scripts/check-format.js",
                    "validate:skills":  "node ../scripts/validate-skills.js",
    "admin:provision":  "node scripts/provision-admin.js",
                    "prisma:validate":  "prisma validate --schema prisma/schema.prisma",
                    "prisma:generate":  "prisma generate --schema prisma/schema.prisma",
                    "verify:db-schema":  "node scripts/verify-schema-sync.js",
                    "audit:db":  "node scripts/audit-db.js",
                    "test:integration":  "node scripts/integration/backend.integration.cjs"
                },
    "keywords":  [
                     "nodejs",
                     "express",
                     "supabase",
                     "postgresql",
                     "mobile-api",
                     "qr-ticket"
                 ],
    "author":  "",
    "license":  "ISC",
    "dependencies":  {
                         "@prisma/client":  "6.19.0",
                         "@supabase/supabase-js":  "^2.39.0",
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.3.1",
                         "express":  "^4.18.2",
                         "express-async-handler":  "^1.2.0",
                         "express-rate-limit":  "^7.5.1",
                         "express-validator":  "^7.0.1",
                         "helmet":  "^8.3.0",
                         "jsonwebtoken":  "^9.0.2",
                         "morgan":  "^1.10.0",
                         "nodemailer":  "^6.10.1",
                         "pg":  "^8.23.1",
                         "qrcode":  "^1.5.3"
                     },
    "devDependencies":  {
                            "nodemon":  "^3.0.1",
                            "prisma":  "6.19.0"
                        }
}
