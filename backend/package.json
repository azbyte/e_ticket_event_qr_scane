{
    "name": "e-ticket-event-qr-scane-backend",
    "version": "1.0.0",
    "description": "Backend API for e-ticket event QR scan mobile app (Flutter)",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "predev": "node scripts/preflight-port.js",
        "dev": "node scripts/dev.js",
        "dev:reset": "node scripts/dev.js --kill-port",
        "test": "node --test",
        "test:sync-config": "node --test ../.github/scripts/validate-sync-config.test.js",
        "check": "node scripts/check-syntax.js",
        "lint": "node scripts/check-syntax.js",
        "format:check": "node scripts/check-format.js",
        "validate:skills": "node ../scripts/validate-skills.js",
        "admin:provision": "node scripts/provision-admin.js",
        "prisma:validate": "prisma validate --schema prisma/schema.prisma",
        "prisma:generate": "prisma generate --schema prisma/schema.prisma",
        "verify:db-schema": "node scripts/verify-schema-sync.js",
        "audit:db": "node scripts/audit-db.js",
        "test:integration": "node scripts/integration/backend.integration.cjs",
        "test:e2e": "node scripts/e2e-live.js",
        "test:registration-flow": "node scripts/e2e-registration-flow.js",
        "verify:ticket-pdf": "node scripts/verify-ticket-pdf.js",
        "verify:email": "node scripts/verify-email-delivery.js",
        "verify:brevo": "node scripts/verify-brevo-smtp.js",
        "email:test": "node scripts/send-test-email.js",
        "verify:email-api": "node scripts/verify-email-api-transport.js",
        "verify:email-queue": "node scripts/verify-async-email-queue.js",
        "verify:ticket-flow": "node scripts/verify-ticket-flow.js",
        "verify:ticket-email-e2e": "node scripts/verify-ticket-email-e2e.js",
        "tickets:backfill-codes": "node scripts/backfill-ticket-codes.js",
        "retry:emails": "node scripts/retry-ticket-emails.js",
        "repair:email-delivery": "node scripts/repair-email-delivery-status.js",
        "cleanup:e2e-data": "node scripts/cleanup-e2e-data.js",
        "test:auth-live": "node scripts/e2e-auth-live.js",
        "test:routes": "node scripts/smoke-routes.js",
        "routes:list": "node scripts/dump-routes.js",
        "verify:auth-db": "node scripts/verify-db-state.js",
        "repair:organizer-profiles": "node scripts/repair-organizer-profiles.js"
    },
    "keywords": [
        "nodejs",
        "express",
        "supabase",
        "postgresql",
        "mobile-api",
        "qr-ticket"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "6.19.0",
        "@supabase/supabase-js": "^2.39.0",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-async-handler": "^1.2.0",
        "express-rate-limit": "^7.5.1",
        "express-validator": "^7.0.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "nodemailer": "^6.10.1",
        "pdfkit": "^0.21.0",
        "pg": "^8.23.1",
        "qrcode": "^1.5.3"
    },
    "devDependencies": {
        "nodemon": "^3.0.1",
        "prisma": "6.19.0"
    }
}
