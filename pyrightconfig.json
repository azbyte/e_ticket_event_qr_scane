{
  // Konfigurasi Pyright/Pylance untuk repository ini — SATU-SATUNYA sumber
  // pengaturan analisis Python. VS Code (`settings.json`) hanya menyimpan
  // pemilihan interpreter, karena Pylance menolak `python.analysis.extraPaths`
  // dan `python.analysis.exclude` ketika berkas ini ada.
  //
  // Skrip validasi e-tiket memakai paket yang TIDAK termasuk dependensi runtime
  // backend: `pymupdf` (PyMuPDF), `cv2` (opencv-python-headless), dan `numpy`.
  // Semua dipasang di virtual environment `backend/.venv` sesuai
  // `backend/tools/requirements.txt`.
  //
  // `venvPath`/`venv` di bawah hanya dipakai Pylance untuk analisis (IntelliSense
  // dan `reportMissingImports`). Ini TIDAK bergantung pada aktivasi terminal:
  // `python.terminal.activateEnvironment` sengaja `false` agar prompt tidak
  // berawalan `(.venv)`, sementara analisis tetap menemukan paket venv.
  "venvPath": "backend",
  "venv": ".venv",
  // `backend` mencakup `tools/*.py` agar import-nya benar-benar dianalisis.
  "include": ["backend"],
  "exclude": [
    "**/node_modules",
    "**/.venv",
    "**/__pycache__",
    "**/.dart_tool",
    "**/build"
  ],
  // Dipertahankan dari konfigurasi VS Code sebelumnya: modul lokal di `backend`
  // dapat diimpor langsung oleh skrip validasi.
  "extraPaths": ["backend"],
  "pythonVersion": "3.14",
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "reportMissingModuleSource": "warning"
}
